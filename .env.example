# ローカル実行用 MQTT 設定サンプル
# このファイルをコピーして .env を作り、実際の値を入力してください。
# .env は .gitignore 対象のため Git には含まれません。
#
# ⚠️ .env.ce とは別ファイルです。
#    .env.ce はデプロイスクリプト（ibmcloud ce ...）専用であり、
#    実行中のアプリ（Code Engine 上のコンテナ含む）はこのファイルを一切参照しません。

# MQTT ブローカーのホスト名（例: xxxxx.s1.eu.hivemq.cloud）
MQTT_HOST=xxxxx.s1.eu.hivemq.cloud

# MQTT ブローカーのポート番号
# mqtts の場合は通常 8883、wss の場合は通常 8884
MQTT_PORT=8883

# 接続プロトコル: mqtts（生MQTT over TLS）または wss（MQTT over WebSocket over TLS）
MQTT_PROTOCOL=mqtts

# MQTT 認証情報
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
