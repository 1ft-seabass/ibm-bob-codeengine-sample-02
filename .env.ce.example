# .env.ce.example
# このファイルは .env.ce の記入例です。
# 実際の値を埋めて .env.ce としてコピーして使ってください。
# .env.ce は Git 管理外（.gitignore 済み）です。このファイルはサンプルとして Git 管理対象です。

# -------------------------------------------------------------------
# 必須設定
# -------------------------------------------------------------------

# ibmcloud ce project select で使う Code Engine プロジェクト名
# 確認: ibmcloud ce project list
IBMCLOUD_TARGET_PROJECT_NAME=your-ce-project-name

# ibmcloud ce buildrun submit で使うビルド定義名
# 確認: ibmcloud ce build list
CE_BUILD_NAME=your-app-name-build

# ibmcloud ce application update で使うアプリ名
# 確認: ibmcloud ce application list
CE_APP_NAME=your-app-name

# ibmcloud ce application update --image で指定するビルド済みイメージの参照先
# 書式: private.<region>.icr.io/<namespace>/build-<CE_BUILD_NAME>:latest
# 確認: ibmcloud ce build get --name $CE_BUILD_NAME
CE_BUILD_IMAGE=private.jp.icr.io/YOUR_NAMESPACE/build-your-app-name-build:latest

# -------------------------------------------------------------------
# 任意設定（必要に応じて .env.ce に追加してください）
# -------------------------------------------------------------------

# デプロイ先リージョン（ibmcloud target -r で切り替える場合に使用）
# 例: jp-tok / us-south / eu-de
# IBMCLOUD_TARGET_REGION=jp-tok

# デプロイ先リソースグループ（ibmcloud target -g で切り替える場合に使用）
# IBMCLOUD_TARGET_RESOURCE_GROUP=default

# buildrun submit 時のコミット指定（省略時は build 定義が参照するブランチの最新コミット）
# 指定する場合: ibmcloud ce buildrun submit --build $CE_BUILD_NAME --commit $CE_BUILD_COMMIT --wait
# CE_BUILD_COMMIT=main

# application update 時の CPU・メモリ上書き（通常は省略。スケール調整時に使用）
# CE_APP_CPU=1
# CE_APP_MEMORY=4G
